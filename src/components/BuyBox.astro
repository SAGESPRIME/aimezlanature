---
/**
 * Sélecteur de quantité à paliers dégressifs + ajout au panier.
 *
 * Hiérarchie visuelle pensée pour la conversion :
 *  1. le total du palier est l'élément dominant (c'est ce que l'acheteur paie) ;
 *  2. l'économie est isolée dans une pastille verte, plus saillante qu'un
 *     simple texte ;
 *  3. le palier sélectionné se distingue par une bordure épaisse, un fond
 *     teinté ET une pastille cochée — trois signaux plutôt qu'un seul, pour
 *     rester lisible y compris en cas de daltonisme.
 *
 * Le palier 2 est présélectionné : c'est le levier de panier moyen de la
 * boutique de référence. Tous les prix viennent de tierPrices() — aucune
 * valeur recopiée à la main.
 *
 * Accessibilité : vrai groupe de boutons radio (role="radiogroup"), navigable
 * au clavier, plutôt que des <div> cliquables.
 */
import type { Product } from '../data/products';
import { tierPrices, fmtPrice } from '../lib/pricing';
import { SITE } from '../data/products';
import Icon from './Icon.astro';
import BandeauLivraison from './BandeauLivraison.astro';
import { fraisLivraison } from '../data/livraison.mjs';

interface Props {
  product: Product;
}
const { product } = Astro.props;
// Livraison d'un exemplaire seul, avec la règle au poids du paiement
// (src/data/livraison.mjs) : 0 = offerte.
const livraisonSeule = fraisLivraison(
  [{ poids: product.poids, qty: 1, offerte: product.livraisonOfferte }],
  SITE.livraison
).frais;
const tiers = tierPrices(product);
const defaut = tiers.find((t) => t.highlight) ?? tiers[0];
// Livraison offerte palier par palier (même règle au poids que le paiement) :
// au-delà du seuil de poids, un palier n'affiche pas la pastille.
const offerte = (qty: number) =>
  fraisLivraison([{ poids: product.poids, qty, offerte: product.livraisonOfferte }], SITE.livraison).frais === 0;
const tousOfferts = tiers.every((t) => offerte(t.qty));
---

{/* Bandeau « livraison offerte » animé (global.css, .livraison-offerte) : le camion
    arrive une fois, un reflet passe trois fois ; immobile si le visiteur a demandé
    moins d'animations. */}
{livraisonSeule === 0 && (
  <BandeauLivraison class="mb-5">
    Colissimo à domicile, 2 à 5 jours{tousOfferts ? ', quelle que soit la formule choisie' : ''}.
  </BandeauLivraison>
)}

<div class="mb-6">
  <p class="mb-3 text-sm font-semibold text-olive">
    Choisissez votre quantité
  </p>

  <div role="radiogroup" aria-label="Choisissez votre quantité" class="space-y-3">
    {tiers.map((t) => (
      <button
        type="button"
        role="radio"
        aria-checked={t.qty === defaut.qty ? 'true' : 'false'}
        data-palier={t.qty}
        class="group relative w-full rounded-xl border-2 border-ligne bg-white px-5 py-4 text-left transition-all hover:border-pierre-fonce aria-checked:border-foret aria-checked:bg-anis-pale aria-checked:shadow-[0_2px_12px_rgba(22,101,52,0.12)]"
      >
        {t.highlight && (
          <span class="absolute -top-2.5 right-4 rounded-full bg-foret px-3 py-0.5 text-[11px] font-bold text-white">
            Le plus populaire
          </span>
        )}

        <span class="flex items-center gap-4">
          <!-- Pastille de sélection : vide, puis cochée -->
          <span
            class="relative flex h-6 w-6 flex-shrink-0 items-center justify-center rounded-full border-2 border-pierre-fonce transition-colors group-aria-checked:border-foret group-aria-checked:bg-foret"
            aria-hidden="true"
          >
            <svg class="h-3.5 w-3.5 text-white opacity-0 transition-opacity group-aria-checked:opacity-100" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 10.5l4 4 8-9" />
            </svg>
          </span>

          <span class="min-w-0 flex-1">
            <span class="block font-semibold text-encre">{t.label}</span>
            <span class="block text-sm text-gris">
              {t.discountPercent > 0 ? (
                <>
                  <s class="text-pierre-fonce">{fmtPrice(product.priceCurrent)} €</s>{' '}
                  <strong class="font-semibold text-foret">{fmtPrice(t.unitPrice)} €</strong> / unité
                </>
              ) : (
                <>{fmtPrice(t.unitPrice)} € / unité</>
              )}
            </span>
            {offerte(t.qty) && (
              <span class="mt-1 inline-flex items-center gap-1 text-xs font-semibold text-foret">
                <Icon name="truck" class="w-3.5 h-3.5" /> Livraison offerte
              </span>
            )}
          </span>

          <span class="flex-shrink-0 text-right">
            <!-- `data-palier-total` : la barre d'achat collante recopie ce montant
                 pour toujours afficher le total du palier réellement sélectionné,
                 sans dupliquer le calcul de prix côté JS. -->
            <span data-palier-total class="block font-display text-2xl font-bold leading-none text-encre">
              {fmtPrice(t.total)} €
            </span>
            {t.saving > 0 && (
              <span class="mt-1.5 inline-block rounded-full bg-anis-clair px-2.5 py-0.5 text-xs font-bold text-foret">
                Économisez {fmtPrice(t.saving)} €
              </span>
            )}
          </span>
        </span>
      </button>
    ))}
  </div>

  <button
    type="button"
    data-ajouter-panier={product.slug}
    class="mt-5 w-full rounded-full bg-foret px-10 py-4 font-semibold text-white transition-colors hover:bg-foret-fonce"
  >
    Ajouter au panier
  </button>

  <!-- Réassurance immédiatement sous le bouton : c'est le moment précis où
       l'acheteur hésite. Les deux promesses reprennent mot pour mot des
       engagements déjà affichés par le marchand (cf. TrustStrip) — ne rien
       ajouter ici qui ne soit pas réellement tenu. -->
  <p class="mt-3 text-center text-sm text-gris">
    Livraison en 2-5 jours —{' '}
    {livraisonSeule === 0 ? (
      <strong class="text-encre">offerte</strong>
    ) : (
      <>
        <strong class="text-encre">{fmtPrice(livraisonSeule ?? SITE.shippingFee)} €</strong>
        {SITE.livraisonOfferteAvec && <>, offerte avec {SITE.livraisonOfferteAvec}</>}
      </>
    )}
  </p>
  <p class="mt-1 text-center text-sm text-gris">
    Prix TTC, TVA incluse · Satisfait ou remboursé 30 jours · Paiement sécurisé
  </p>

  <!-- Guide d'utilisation fourni par le marchand (68 pages, 1,1 Mo).
       Auto-hébergé dans public/ plutôt que lié vers l'URL CloudFront d'origine :
       un lien externe casserait sans prévenir le jour où le fichier est déplacé,
       et le PDF profite ici du cache du CDN Cloudflare.
       Le poids et le format sont annoncés dans le libellé : un lien qui déclenche
       un téléchargement d'un mégaoctet sans le dire est un mauvais procédé. -->
  <p class="mt-3 border-t border-ligne pt-3 text-center text-sm text-gris">
    <Icon name="bulb" class="mr-1 inline h-4 w-4 align-text-bottom text-foret" />
    Guide d'utilisation offert avec votre commande —{' '}
    <a
      href="/guide-perles-de-ceramique-em.pdf"
      target="_blank"
      rel="noopener"
      class="font-semibold text-foret underline"
    >
      le feuilleter (PDF, 68 pages)
    </a>
  </p>

  <!-- Sans JavaScript, le panier ne fonctionne pas : la commande par email
       reste accessible plutôt que de laisser un bouton inerte. -->
  <noscript>
    <p class="mt-4 rounded-xl border border-pierre bg-coquille p-4 text-sm text-gris">
      Le panier nécessite JavaScript. Vous pouvez commander par email à{' '}
      <a href="mailto:commande@aimezlanature.fr" class="font-semibold text-foret underline">commande@aimezlanature.fr</a>.
    </p>
  </noscript>
</div>
