---
/**
 * Bandeau de consentement aux cookies de mesure publicitaire.
 *
 * Exigences CNIL tenues ici :
 *   — « Refuser » est au MÊME niveau que « Accepter » : même écran, même taille,
 *     même style de bouton. Un refus plus difficile que l'acceptation invalide
 *     le consentement.
 *   — La finalité est nommée en clair, ainsi que le tiers destinataire (Google).
 *   — Aucune case pré-cochée, aucun consentement déduit du défilement.
 *   — Le choix se change à tout moment par « Gérer les cookies » en pied de page.
 *
 * `hidden` par défaut, et c'est important à deux titres :
 *   1. Sans JavaScript, aucun script Google n'est chargé (c'est le JS qui les
 *      charge) : il n'y a donc rien à consentir, et le bandeau reste masqué à
 *      juste titre. Comportement fail-closed.
 *   2. Le visiteur qui a déjà répondu ne voit jamais le bandeau clignoter.
 *
 * `position: fixed` (cf. global.css) : le bandeau se superpose au contenu au
 * lieu de le pousser. Un bandeau dans le flux normal ferait remonter le CLS que
 * l'on vient de ramener à 0,00.
 */
import { ID_ADS } from '../data/tracking';
---

<div
  data-bandeau-cookies
  data-id-ads={ID_ADS}
  hidden
  role="dialog"
  aria-modal="false"
  aria-labelledby="titre-cookies"
  aria-describedby="texte-cookies"
  class="fixed bottom-0 left-0 right-0 z-[70] border-t border-stone-200 bg-white shadow-[0_-4px_20px_rgba(0,0,0,0.08)]"
>
  <div class="max-w-6xl mx-auto px-4 py-4 sm:py-5">
    <h2 id="titre-cookies" class="font-display text-lg text-stone-800 mb-1">
      Mesurer l'efficacité de nos publicités
    </h2>
    <p id="texte-cookies" class="text-sm text-stone-600 leading-relaxed mb-4">
      Nous aimerions déposer des cookies de <strong>Google Ads</strong> pour savoir
      quelles annonces vous ont amené jusqu'ici. C'est notre seul usage, et il n'a
      rien d'indispensable : le site fonctionne à l'identique si vous refusez.{' '}
      <a href="/mentions-legales/#cookies" class="underline hover:text-green-700">
        Détail des cookies et de leur durée
      </a>.
    </p>

    <!-- Les deux boutons sont volontairement de POIDS VISUEL ÉGAL : mêmes
         classes à la couleur près, tous deux pleins avec du texte blanc et une
         bordure, donc exactement la même boîte et le même contraste. Le motif
         courant « Accepter en vert plein / Refuser en gris clair » rend le refus
         moins saillant, ce que la CNIL analyse comme un procédé qui vicie le
         consentement. Ne pas « alléger » le bouton Refuser. -->
    <div class="flex flex-col sm:flex-row gap-2 sm:gap-3">
      <button
        type="button"
        data-consent-accepter
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-semibold border bg-green-700 border-green-700 text-white hover:bg-green-800 hover:border-green-800 transition-colors"
      >
        Accepter
      </button>
      <button
        type="button"
        data-consent-refuser
        class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-semibold border bg-stone-700 border-stone-700 text-white hover:bg-stone-800 hover:border-stone-800 transition-colors"
      >
        Refuser
      </button>
    </div>
  </div>
</div>
