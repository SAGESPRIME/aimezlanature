---
// Bandeau de conversion compact — réutilisé en bas des guides et pages info.
import { products, SITE } from '../data/products';
const packs = products.filter((p) => p.inStock);
---

<section class="py-16 lg:py-20 px-4 sm:px-6 bg-nuit text-white" aria-labelledby="cta-packs-titre">
  <div class="max-w-5xl mx-auto text-center">
    <p class="text-sm text-anis mb-3">Passer à l'action</p>
    <h2 id="cta-packs-titre" class="font-display text-3xl lg:text-4xl mb-3">Prêt à purifier votre eau ?</h2>
    <p class="text-anis-clair mb-10 max-w-xl mx-auto">
      Perles de Céramique EM® authentiques, fabriquées au Japon. Livraison offerte dès {SITE.freeShippingThreshold} €,
      garantie 30 jours, emballage sans plastique.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-4xl mx-auto">
      {packs.map((p) => (
        <a
          href={`/perles-ceramique-em/${p.slug}/`}
          class="bg-white/5 border border-white/15 rounded-xl p-5 hover:bg-white/10 hover:border-anis transition-colors text-left"
        >
          <p class="font-display text-lg mb-1">{p.shortName}</p>
          <p class="text-xs text-anis-clair mb-3">{p.usages[0]}</p>
          <p class="font-bold text-anis">{p.priceCurrent.toFixed(2).replace('.', ',')} €</p>
        </a>
      ))}
    </div>
    <a href="/perles-ceramique-em/" class="inline-block mt-8 text-sm font-semibold text-anis border-b border-anis pb-0.5 hover:text-white hover:border-white transition-colors">
      Comparer tous les packs →
    </a>
  </div>
</section>
