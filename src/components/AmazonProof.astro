---
/**
 * Preuve sociale Amazon — bandeau réutilisable.
 *
 * Les 816 avis à 4,6/5 viennent de la fiche Amazon, pas des avis collectés
 * ici : la mention « sur Amazon » est donc affichée systématiquement, et ces
 * chiffres ne sont jamais mélangés à la note du site (4,8/5 sur 96 avis).
 * Les deux notes cohabitent parce qu'elles sont explicitement attribuées à
 * deux sources différentes.
 *
 * Source unique des chiffres : SITE.amazon dans src/data/products.ts.
 *
 * Aucun lien vers Amazon (choix du marchand) : le visiteur reste sur le site
 * et commande ici. Seuls les chiffres sont cités, avec leur source.
 */
import { SITE } from '../data/products';

interface Props {
  /** `bandeau` : pleine largeur sur fond crème. `ligne` : compact, en flux. */
  variant?: 'bandeau' | 'ligne';
  class?: string;
}

const { variant = 'bandeau', class: className = '' } = Astro.props;

const note = SITE.amazon.rating.toString().replace('.', ',');
const avis = SITE.amazon.reviewCount.toLocaleString('fr-FR');
const label = `Note de ${note} sur 5 sur Amazon, fondée sur ${avis} commentaires`;
---

{variant === 'ligne' ? (
  /* Pas d'étoiles dans cette variante : elle s'affiche juste sous la note du
     produit (4,91/5). Deux rangées d'étoiles côte à côte se lisaient comme deux
     notes concurrentes, et le visiteur retenait la plus basse. Formulée en
     renfort de VOLUME, la mention Amazon ajoute de la crédibilité au lieu d'en
     retirer — les deux chiffres restent attribués à leur source, jamais
     additionnés en un total inventé. */
  <p class={`flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gris ${className}`}>
    <span aria-label={label}>
      <span aria-hidden="true">+ </span>
      <strong class="text-encre">{avis} commentaires</strong> sur Amazon
      <span class="text-olive"> ({note}/5)</span>
    </span>
  </p>
) : (
  <section class={`py-10 px-4 bg-anis-pale ${className}`} aria-labelledby="amazon-titre">
    <div class="max-w-4xl mx-auto rounded-xl border border-pierre bg-white px-6 py-6 text-center">
      <p id="amazon-titre" class="text-sm text-olive mb-3">
        Aussi vendu sur Amazon
      </p>
      <p class="etoiles text-2xl mb-2" aria-label={label}>
        ★★★★★
        <span class="font-display font-bold text-encre align-middle ml-2">{note}/5</span>
      </p>
      <p class="text-gris">
        <strong class="text-encre">{avis} commentaires</strong> laissés par les clients
        Amazon sur nos Perles de Céramique EM®, depuis {SITE.foundingYear}.
      </p>
    </div>
  </section>
)}
