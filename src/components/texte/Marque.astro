---
// Gras, italique et liens d'un texte riche. Un lien externe s'ouvre dans le
// même onglet mais ne transmet ni l'origine ni de « jus SEO » non voulu.
//
// Lien vers un article du blog pas (encore) publié : rendu en texte simple.
// Un article publié peut ainsi citer un article encore en brouillon ; le lien
// s'active tout seul au build qui suit la publication — jamais de lien cassé.
import type { MarkProps } from 'astro-portabletext/types';
import { blogPosts } from '../../data/blogPosts';
type Props = MarkProps<{ href?: string }>;
const { node } = Astro.props;
const href = node.markDef?.href ?? '';
const externe = /^https?:\/\//.test(href);
const article = href.match(/^\/blog\/[^/?#]+\/?/)?.[0];
const actif = !article || blogPosts.some((p) => p.href === (article.endsWith('/') ? article : `${article}/`));
---

{node.markType === 'strong' ? (
  <strong class="text-encre"><slot /></strong>
) : node.markType === 'em' ? (
  <em><slot /></em>
) : node.markType === 'link' && href && actif ? (
  <a href={href} class="text-foret font-semibold hover:underline" rel={externe ? 'noopener' : undefined}><slot /></a>
) : (
  <slot />
)}
