---
import type { ListProps } from 'astro-portabletext/types';
type Props = ListProps;
const { node } = Astro.props;
---

{node.listItem === 'number' ? (
  <ol class="list-decimal pl-5 space-y-2 text-[#57534e] leading-relaxed mb-5"><slot /></ol>
) : (
  <ul class="list-disc pl-5 space-y-2 text-[#57534e] leading-relaxed mb-5"><slot /></ul>
)}
