---
import '../styles/global.css';
import { Image } from 'astro:assets';
import { SITE, getProduct } from '../data/products';
import { jsonPourScript } from '../lib/json-script';
import { getCollection } from 'astro:content';
import CartDrawer from '../components/CartDrawer.astro';
import Footer from '../components/Footer.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import BandeauCookies from '../components/BandeauCookies.astro';
import logo from '../assets/logo.png';

// Polices préchargées. Le suffixe `?url` demande à Vite l'URL finale du fichier
// émis (avec son empreinte) : un chemin écrit en dur casserait au prochain build.
//
// Pourquoi précharger : ces woff2 ne sont déclarés que dans le CSS, donc le
// navigateur ne les découvre qu'après avoir téléchargé ET parsé la feuille de
// style. Le texte s'affiche d'abord dans la police de repli (system-ui, Georgia)
// puis saute quand la vraie police arrive — c'est ce saut qui donnait un CLS de
// 0,11, au-dessus du seuil « bon » de 0,10 (cause confirmée par une trace
// Chrome DevTools qui nomme les 6 fichiers de police).
//
// Seules les polices réellement visibles au-dessus de la ligne de flottaison
// sont préchargées (~70 Ko) : Cormorant 600 porte le H1 (le plus gros texte,
// donc le plus gros décalage), Cormorant 500 italique le mot surligné du H1,
// Instrument Sans (variable : un fichier pour toutes les graisses) le texte et
// les boutons. Le reste est découvert via le CSS, pour ne pas voler de bande
// passante à l'image LCP (fetchpriority="high").
import fontTitre600 from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-600-normal.woff2?url';
import fontTitre500i from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-italic.woff2?url';
import fontTexte from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

const policesAPrecharger = [fontTitre600, fontTitre500i, fontTexte];

interface Props {
  title: string;
  description: string;
  canonical?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  /** Dimensions réelles de l'image de partage (par défaut celles de /og-default.jpg). */
  ogImageLargeur?: number;
  ogImageHauteur?: number;
  /**
   * Date ISO de la dernière modification SIGNIFICATIVE du contenu (prix,
   * stock, texte d'article). Émise en og:updated_time et reprise comme
   * <lastmod> dans le sitemap (astro.config.mjs).
   */
  modifieLe?: string;
}

const {
  title,
  description,
  canonical,
  jsonLd,
  noindex = false,
  ogImage = '/og-default.jpg',
  ogImageAlt = 'Aimez la Nature — Perles de Céramique EM® authentiques du Japon pour purifier l\'eau du robinet',
  ogImageLargeur = 1200,
  ogImageHauteur = 630,
  modifieLe,
} = Astro.props;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, SITE.url).href;

// Normalise jsonLd en tableau pour le slot
const schemas = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];

// Schema BreadcrumbList pour toutes les pages.
// Libellés lisibles : sans cette map, Google recevrait les slugs capitalisés
// (« Perles Ceramique Em », « Cgv ») dans le fil d'Ariane des résultats.
const segmentLabels: Record<string, string> = {
  'perles-ceramique-em': 'Perles de Céramique EM',
  'comment-ca-marche': 'Comment ça marche',
  'utilisations': '16 utilisations',
  'purifier-eau-robinet-comparatif': 'Comparatif purification',
  'blog': 'Guides',
  'a-propos': 'À propos',
  'faq': 'FAQ',
  'cgv': 'CGV',
  'contact': 'Contact',
  'mentions-legales': 'Mentions légales',
  'revendeurs': 'Devenir revendeur',
  'merci': 'Merci',
  'panier': 'Panier',
  'commande-confirmee': 'Commande confirmée',
  'avis': 'Avis',
  // Les articles du blog fournissent leur propre libellé (champ « libellé
  // court » dans Sanity) : voir libellesArticles ci-dessous.
};

const libellesArticles: Record<string, string> = Object.fromEntries(
  (await getCollection('articles')).map((a) => [a.id, a.data.libelleCourt])
);

function segmentLabel(seg: string): string {
  return (
    segmentLabels[seg] ??
    libellesArticles[seg] ??
    getProduct(seg)?.shortName ??
    seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase())
  );
}

const breadcrumbSegments = Astro.url.pathname
  .replace(/\/$/, '')
  .split('/')
  .filter(Boolean);

const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: 'Accueil', item: SITE.url + '/' },
  ...breadcrumbSegments.map((seg, i) => ({
    '@type': 'ListItem',
    position: i + 2,
    name: segmentLabel(seg),
    item: SITE.url + '/' + breadcrumbSegments.slice(0, i + 1).join('/') + '/',
  })),
];

const breadcrumbSchema =
  breadcrumbItems.length > 1
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: breadcrumbItems,
      }
    : null;

const allSchemas = breadcrumbSchema ? [breadcrumbSchema, ...schemas] : schemas;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Préchargement des polices de la ligne de flottaison, placé le plus haut
         possible pour que le navigateur lance les requêtes avant même d'avoir lu
         le reste du <head>. `crossorigin` est OBLIGATOIRE sur un preload de
         police, même en même origine : sans lui le navigateur télécharge le
         fichier une seconde fois et le préchargement ne sert à rien. -->
    {policesAPrecharger.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}

    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Pas de canonical sur une page noindex : les deux signaux se contredisent
        (« ne m'indexe pas » / « indexe cette URL »), et la 404 déclarait une
        URL /404/ qui n'existe pas. */}
    {!noindex && <link rel="canonical" href={canonicalUrl} />}

    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <!-- Vérification Google Search Console. Valeur relevée le 2026-07-29 dans le
         HTML du WordPress encore en ligne sur aimezlanature.fr : si la propriété
         GSC est vérifiée par cette balise, la retirer à la bascule ferait perdre
         l'accès à la Search Console (et donc au suivi de la migration).
         Ce jeton est public par nature, il n'y a rien à protéger ici.
         NE PAS SUPPRIMER sans avoir d'abord confirmé qu'une vérification par
         TXT DNS a pris le relais sur le domaine. -->
    <meta
      name="google-site-verification"
      content="UhQ55Ibs19Xue-Hi6BWyZzfUG9tOYktlkTzEVH2T1hg"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={new URL(ogImage, SITE.url).href} />
    <!-- Dimensions + alt : sans elles, Facebook/LinkedIn recadrent l'aperçu au
         hasard et les lecteurs d'écran n'ont aucune description. L'image par
         défaut (/og-default.jpg) fait 1200×630, le ratio 1.91:1 attendu. -->
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogImageLargeur)} />
    <meta property="og:image:height" content={String(ogImageHauteur)} />
    {modifieLe && <meta property="og:updated_time" content={modifieLe} />}
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, SITE.url).href} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Polices auto-hébergées (@fontsource, importées dans global.css) :
         supprime les requêtes render-blocking vers Google Fonts et le
         transfert d'IP vers Google (position CNIL/RGPD). -->

    <!-- JSON-LD Structured Data (SSR only) -->
    {allSchemas.map((schema) => (
      <script type="application/ld+json" set:html={jsonPourScript(schema)} />
    ))}
  </head>
  <body class="bg-coquille text-encre font-sans antialiased overflow-x-hidden">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:absolute focus:z-[60] focus:top-2 focus:left-2 focus:bg-white focus:text-foret-fonce focus:px-4 focus:py-2 focus:rounded-lg focus:shadow"
    >
      Aller au contenu
    </a>

    <!-- Bande d'annonce (défile hors de l'écran ; le header reste seul en sticky) -->
    <AnnouncementBar />

    <!-- Navigation. Bureau : liens à gauche, logo centré, panier à droite
         (mise en page éditoriale, docs/design/systeme.md). Mobile : logo à
         gauche, panier + menu à droite. -->
    <header class="sticky top-0 z-50 bg-coquille/95 backdrop-blur border-b border-ligne">
      <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-16 lg:h-20 grid grid-cols-[1fr_auto] lg:grid-cols-[1fr_auto_1fr] items-center gap-4" aria-label="Navigation principale">
        <ul class="hidden lg:flex items-center gap-6 xl:gap-7 text-sm text-encre whitespace-nowrap list-none p-0 m-0">
          <li><a href="/perles-ceramique-em/" class="lien-nav">Nos perles</a></li>
          <li><a href="/comment-ca-marche/" class="lien-nav">Comment ça marche</a></li>
          <li><a href="/utilisations/" class="lien-nav">Utilisations</a></li>
          <li><a href="/blog/" class="lien-nav">Guides</a></li>
        </ul>
        <a href="/" class="justify-self-start lg:justify-self-center flex-shrink-0" aria-label="Aimez la Nature — accueil">
          <Image
            src={logo}
            alt="Aimez la Nature"
            width={373}
            height={109}
            widths={[186, 373]}
            sizes="(min-width: 1024px) 164px, 130px"
            loading="eager"
            class="h-9 lg:h-12 w-auto"
          />
        </a>
        <div class="flex items-center justify-end gap-2 sm:gap-4">
          <a href="/faq/" class="hidden xl:inline lien-nav text-sm text-encre">FAQ</a>
          <a href="/a-propos/" class="hidden xl:inline lien-nav text-sm text-encre whitespace-nowrap">Notre mission</a>
          <a
            href="/panier/"
            data-ouvrir-panier
            class="relative inline-flex items-center justify-center w-11 h-11 rounded-full text-encre hover:bg-anis-pale transition-colors"
            aria-label="Voir mon panier"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z" />
              <path d="M3 6h18M16 10a4 4 0 0 1-8 0" />
            </svg>
            <span
              data-panier-compteur
              hidden
              class="absolute top-0.5 right-0.5 min-w-5 h-5 px-1 rounded-full bg-anis text-encre text-xs font-bold flex items-center justify-center"
            >0</span>
          </a>
          <button
            id="menu-toggle"
            type="button"
            class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-full text-encre hover:bg-anis-pale transition-colors"
            aria-expanded="false"
            aria-controls="menu-mobile"
            aria-label="Ouvrir le menu"
          >
            <svg class="w-5 h-5 menu-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <svg class="w-5 h-5 menu-icon-close hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
        </div>
      </nav>
      <!-- Panneau mobile, replié par défaut, déplié par le bouton (js/site.js).
           Sans JS, tous les liens restent accessibles via le footer. -->
      <ul id="menu-mobile" class="hidden lg:hidden border-t border-ligne bg-coquille px-4 py-3 space-y-1 text-base text-encre list-none m-0">
        <li><a href="/perles-ceramique-em/" class="block px-2 py-3 rounded-lg hover:bg-anis-pale">Nos perles</a></li>
        <li><a href="/comment-ca-marche/" class="block px-2 py-3 rounded-lg hover:bg-anis-pale">Comment ça marche</a></li>
        <li><a href="/utilisations/" class="block px-2 py-3 rounded-lg hover:bg-anis-pale">16 utilisations</a></li>
        <li><a href="/blog/" class="block px-2 py-3 rounded-lg hover:bg-anis-pale">Guides</a></li>
        <li><a href="/faq/" class="block px-2 py-3 rounded-lg hover:bg-anis-pale">FAQ</a></li>
        <li><a href="/a-propos/" class="block px-2 py-3 rounded-lg hover:bg-anis-pale">Notre mission</a></li>
        <li><a href="/contact/" class="block px-2 py-3 rounded-lg hover:bg-anis-pale">Contact</a></li>
      </ul>
    </header>

    <!-- Breadcrumb (visible only on inner pages) -->
    {breadcrumbItems.length > 1 && (
      <nav class="max-w-6xl mx-auto px-4 py-3" aria-label="Fil d'Ariane">
        <ol class="flex flex-wrap items-center gap-2 text-xs text-gris">
          {breadcrumbItems.map((item, i) => (
            <li class="flex items-center gap-2">
              {i > 0 && <span aria-hidden="true">/</span>}
              {i < breadcrumbItems.length - 1 ? (
                <a href={item.item} class="hover:text-foret transition-colors">{item.name}</a>
              ) : (
                <span class="text-encre font-medium">{item.name}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <!-- Main content -->
    <main id="contenu">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />

    <!-- JS minimal, servi en fichier externe pour rester compatible avec la CSP
         (script-src 'self') : menu mobile + apparitions au défilement. -->
    <CartDrawer />

    <!-- Bandeau de consentement. Placé après le contenu : il se superpose en
         `position: fixed`, sa position dans le DOM n'affecte pas l'affichage,
         et il ne s'interpose pas dans l'ordre de tabulation du contenu. -->
    <BandeauCookies />

    <script src="/js/site.js" defer></script>
    <script src="/js/cart.js" defer></script>
    <!-- Pilote le bandeau ET décide du chargement de Google Ads : aucun script
         Google n'est demandé avant un clic explicite sur « Accepter ». -->
    <script src="/js/consentement.js" defer></script>
  </body>
</html>
