---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import AmazonProof from '../components/AmazonProof.astro';
import Irritants from '../components/Irritants.astro';
import { SITE, getProduct, prixDEntree } from '../data/products';
import { faqPour } from '../data/faq';
import { guides } from '../data/guides';
import { conditionsPro } from '../data/revendeur';
import CarteProduit from '../components/CarteProduit.astro';
import BandeauLivraison from '../components/BandeauLivraison.astro';
import { photoSite, cadrage, formatPhoto } from '../data/photosSite';
import { buildFaqSchema, buildOrganizationSchema, buildWebSiteSchema } from '../lib/seo';


const metaTitle = 'Perles Céramique EM® — Purifiez votre eau | Aimez la Nature';
const metaDescription =
  `Purifiez l'eau du robinet avec nos Perles de Céramique EM® japonaises. ${SITE.totalReviews} avis vérifiés, livraison offerte selon le pack, garantie 30 jours.`;

const organizationSchema = buildOrganizationSchema();
const websiteSchema = buildWebSiteSchema();

// Pas de schema Product « catalogue » avec note agrégée ici : Google exige
// qu'un aggregateRating porte sur un produit précis — agréger les avis de
// plusieurs produits dans un Product fictif violerait ses consignes.
// Les notes réelles restent dans le schema Product de chaque fiche.

// Mode d'emploi : une vraie séquence, d'où la numérotation affichée.
const steps = [
  {
    num: '01',
    titre: 'Placez les perles dans votre eau',
    texte: 'Déposez les perles au fond de votre carafe, bouilloire ou gourde. Aucun montage, aucun raccordement.',
  },
  {
    num: '02',
    titre: 'L\'eau s\'améliore naturellement',
    texte: 'En 30 minutes, le chlore est réduit, le goût s\'adoucit, le tartre diminue. Efficacité sur 3 à 6 mois.',
  },
  {
    num: '03',
    titre: 'Régénérez par simple ébullition',
    texte: 'Faites bouillir les perles 10 à 15 minutes pour leur redonner toute leur efficacité. Répétez tous les 3-6 mois.',
  },
];

// Extraits d'avis clients RÉELS, copiés mot pour mot depuis le JSON-LD des
// fiches produit d'aimezlanature.fr (relevé le 2026-07-20, avis 5/5 publiés
// avec ces noms). Ne jamais remplacer par des témoignages rédigés : un avis
// invérifiable = pratique commerciale trompeuse (art. L121-2 Code conso).
const testimonials = [
  {
    name: 'Amine B.',
    pack: 'Pack 55',
    texte: 'Ces microbilles sont vraiment efficaces dans ma carafe, on ne sent plus du tout l\'odeur chlorée, de plus l\'eau est beaucoup plus douce.',
  },
  {
    name: 'Corine M.',
    pack: 'Pack 100',
    texte: 'J\'intègre ces perles céramiques dans ma bouilloire ainsi que dans ma machine à café : adieu le tartre et fini les produits anti-calcaire chimiques.',
  },
  {
    name: 'Patrick D.',
    pack: 'Pack 100',
    texte: 'Ces perles correspondent exactement à ce qui était décrit. Je constate une véritable amélioration de la qualité de l\'eau dans ma carafe.',
  },
];

// FAQ produit affichée sur l'accueil. Google exige que les réponses soient
// VISIBLES sur la page pour accepter le schema FAQPage : le composant <Faq>
// rend l'accordéon, buildFaqSchema() génère le JSON-LD à partir des mêmes
// données. Questions choisies pour les requêtes informationnelles à fort
// volume ; réponses fidèles aux données réelles (dosage 15/L, régénération
// par ébullition, honnêteté sur bactéries/métaux — cf. /perles-de-ceramique-avis).
// Questions gérées dans Sanity (Studio → Questions fréquentes → page « accueil »).
const homeFaqItems = faqPour('accueil');

const homeFaqSchema = buildFaqSchema(homeFaqItems);

// Cartes « Choisissez votre format » : la mise en page est propre à ces quatre
// produits, mais prix, prix barrés et notes viennent TOUJOURS des données
// (Sanity). Ils étaient écrits en dur ici : un changement de prix dans le
// Studio n'aurait pas atteint la page d'accueil.
function carte(slug: string) {
  const p = getProduct(slug);
  if (!p) throw new Error(`Accueil : produit « ${slug} » introuvable dans le contenu`);
  return p;
}
const p100 = carte('pack-100-perles');
const p55 = carte('pack-55-perles');
const pGourdePack = carte('pack-gourde-ceramique-em');
const pGourde = carte('gourde-ecologique');

// Ordre et accroche de chaque carte « Choisissez votre format ».
const formats = [
  { p: p100, usage: 'Carafe, bouilloire, lave-vaisselle : le format famille' },
  { p: p55, usage: "Carafe, bouilloire, cafetière : le format d'entrée" },
  { p: pGourdePack, usage: 'Gourde en verre 500 ml et 100 perles' },
  { p: pGourde, usage: 'Si vous avez déjà vos perles' },
];

// Tuiles « Pour chaque moment d'eau » : photos modifiables dans le Studio
// (Réglages → Photos du site), photo de secours sinon (src/data/photosSite.ts).
const moments = [
  { href: '/comment-ca-marche/', titre: 'Comment ça marche', texte: "Ce que font les perles dans l'eau", photo: photoSite('commentCaMarche'), cadre: cadrage('commentCaMarche') },
  { href: '/utilisations/', titre: 'À la maison', texte: 'Carafe, bouilloire, cafetière, plantes…', photo: photoSite('maison'), cadre: cadrage('maison') },
  { href: '/perles-ceramique-em/gourde-ecologique/', titre: 'En balade', texte: 'La gourde en verre et ses perles', photo: photoSite('balade'), cadre: cadrage('balade') },
  { href: '/a-propos/', titre: 'Notre mission', texte: 'Moins de bouteilles plastique', photo: photoSite('mission'), cadre: cadrage('mission') },
];
const photoHero = photoSite('accueil');
// Cadre du hero à la forme de la photo (après recadrage du Studio) : une photo
// portrait n'est plus rognée dans un carré, et inversement.
const cadreHero = { portrait: 'lg:aspect-[4/5]', carre: 'lg:aspect-square', paysage: 'lg:aspect-[4/3]' }[formatPhoto('accueil')];
const photoModeEmploi = photoSite('modeEmploi');
const note = (n: number) => n.toString().replace('.', ',');
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={[organizationSchema, websiteSchema, homeFaqSchema]}>

  <!-- ══════════════════════════════════
       HERO — texte éditorial + photo en arche (docs/design/systeme.md).
       La photo est l'image LCP : eager + fetchpriority="high". En mobile elle
       passe au-dessus du texte, avec une hauteur fixe pour garder le bouton
       d'achat dans le premier écran.
  ══════════════════════════════════ -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 grid lg:grid-cols-[1.05fr_1fr] gap-0 lg:gap-12">
    <div class="flex flex-col justify-center pt-7 pb-12 lg:py-20">
      <p class="entree text-sm text-olive font-medium mb-5">
        Perles de Céramique EM® authentiques, fabriquées au Japon
      </p>
      <h1 class="entree entree-2 font-display text-[2.75rem] sm:text-6xl xl:text-[4.1rem] text-encre leading-[1.02] mb-6 text-balance">
        L'eau du robinet, <em class="surligne">purifiée</em> naturellement.
      </h1>
      <p class="entree entree-3 text-gris text-lg leading-relaxed max-w-[34ch] mb-9">
        Des perles d'argile EM® à déposer dans votre carafe ou votre gourde : moins de chlore,
        une eau plus douce, moins de tartre. Sans filtre ni plastique.
      </p>
      {SITE.livraisonOfferteAvec && (
        <BandeauLivraison class="entree entree-4 mb-6 max-w-lg">
          Avec {SITE.livraisonOfferteAvec}, en Colissimo, 2 à 5 jours.
        </BandeauLivraison>
      )}
      <div class="entree entree-4 flex flex-col sm:flex-row sm:flex-wrap gap-3 mb-10">
        <a href="/perles-ceramique-em/" class="bouton bouton-plein">
          Choisir mes perles, dès {prixDEntree()}
        </a>
        <a href="/comment-ca-marche/" class="bouton bouton-contour">
          Comment ça marche
        </a>
      </div>
      <dl class="entree entree-5 grid grid-cols-3 gap-4 border-t border-ligne pt-6 max-w-lg">
        <div>
          <dt class="sr-only">Note moyenne</dt>
          <dd class="font-display text-2xl sm:text-3xl text-encre leading-none">
            {note(SITE.globalRating)}/5 <span class="etoiles text-base align-middle" aria-hidden="true">★★★★★</span>
          </dd>
          <dd class="text-xs sm:text-sm text-gris mt-2">{SITE.totalReviews} avis vérifiés</dd>
        </div>
        <div>
          <dt class="sr-only">Livraison</dt>
          <dd class="font-display text-2xl sm:text-3xl text-encre leading-none">Offerte</dd>
          <dd class="text-xs sm:text-sm text-gris mt-2">livraison selon le pack</dd>
        </div>
        <div>
          <dt class="sr-only">Garantie</dt>
          <dd class="font-display text-2xl sm:text-3xl text-encre leading-none">30 jours</dd>
          <dd class="text-xs sm:text-sm text-gris mt-2">satisfait ou remboursé</dd>
        </div>
      </dl>
    </div>
    <div class={`order-first lg:order-none -mx-4 sm:mx-0 aspect-[4/3] ${cadreHero} lg:self-center overflow-hidden arche-hero entree-photo`}>
      <Image
        {...photoHero}
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 1024px) 560px, 100vw"
        loading="eager"
        fetchpriority="high"
        class={`w-full h-full object-cover ${cadrage('accueil')}`}
      />
    </div>
  </section>

  <!-- ══════════════════════════════════
       FORMATS — les 4 produits, photo produit sur fond blanc.
       Pas de `data-reveal` : la section qui vend doit être visible même si
       site.js ne charge pas. Prix et notes viennent toujours de Sanity.
  ══════════════════════════════════ -->
  <section class="py-20 lg:py-28 px-4 sm:px-6" aria-labelledby="produits-titre">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
        <h2 id="produits-titre" class="font-display text-4xl lg:text-5xl text-foret">Choisissez votre format</h2>
        <a href="/perles-ceramique-em/" class="lien-souligne">Comparer les packs</a>
      </div>
      <ul class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-10 lg:gap-6 list-none p-0 m-0">
        {formats.map(({ p, usage }) => (
          <li><CarteProduit produit={p} accroche={usage} /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════════
       LE CONSTAT — nommer le problème avant de montrer la solution
  ══════════════════════════════════ -->
  <Irritants />

  <!-- ══════════════════════════════════
       MOMENTS — tuiles photo vers les pages de contenu
  ══════════════════════════════════ -->
  <section class="py-20 lg:py-28 px-4 sm:px-6" aria-labelledby="moments-titre">
    <div class="max-w-6xl mx-auto">
      <h2 id="moments-titre" class="font-display text-4xl lg:text-5xl text-foret mb-10">Pour chaque moment d'eau</h2>
      <ul class="tuiles-moments list-none p-0 m-0">
        {moments.map((m, i) => (
          <li>
            <a href={m.href} class="tuile-moment group">
              <Image
                {...m.photo}
                widths={[640, 960, 1280]}
                sizes={i === 0 ? '(min-width: 1024px) 840px, 100vw' : '(min-width: 1024px) 720px, 100vw'}
                class={`tuile-moment-photo ${m.cadre}`}
              />
              <span class="tuile-moment-texte">
                <span class="block font-display text-2xl sm:text-3xl text-white">{m.titre}</span>
                <span class="block text-sm text-white/90 mt-1">{m.texte}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════════
       MODE D'EMPLOI — bloc GEO. Vraie séquence : numérotée.
  ══════════════════════════════════ -->
  <section class="py-20 lg:py-28 px-4 sm:px-6 bg-anis-pale" aria-labelledby="how-it-works">
    <div class="max-w-6xl mx-auto grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div class="arche-portrait aspect-[5/6] max-w-md w-full mx-auto lg:mx-0">
        <Image
          {...photoModeEmploi}
          widths={[800, 1100, 1400]}
          sizes="(min-width: 1024px) 1100px, 830px"
          class={`w-full h-full object-cover ${cadrage('modeEmploi')}`}
        />
      </div>
      <div>
        <h2 id="how-it-works" class="font-display text-4xl lg:text-5xl text-foret mb-4">Comment ça marche ?</h2>
        <p class="text-gris leading-relaxed mb-8 max-w-[60ch]">
          Les Perles de Céramique EM® sont fabriquées à partir d'argile naturelle enrichie en
          Micro-organismes Efficaces (EM®). Ces micro-organismes bénéfiques améliorent la qualité
          de l'eau en réduisant le chlore, en adoucissant le goût et en limitant le tartre.
          Durée d'efficacité : 3 à 6 mois selon l'usage.
        </p>
        <ol class="list-none p-0 m-0 border-t border-pierre">
          {steps.map(({ num, titre, texte }) => (
            <li class="grid grid-cols-[3rem_1fr] gap-2 py-5 border-b border-pierre">
              <span class="font-display text-2xl text-olive leading-none pt-0.5" aria-hidden="true">{num}</span>
              <div>
                <h3 class="font-semibold text-encre mb-1">{titre}</h3>
                <p class="text-gris text-sm leading-relaxed">{texte}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="flex flex-wrap gap-x-8 gap-y-3 mt-8">
          <a href="/comment-ca-marche/" class="lien-souligne">Le fonctionnement en détail</a>
          <a href="/utilisations/" class="lien-souligne">Les 16 utilisations</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       AVIS — extraits mot pour mot d'avis vérifiés
  ══════════════════════════════════ -->
  <section class="py-20 lg:py-28 px-4 sm:px-6" aria-labelledby="avis-titre">
    <div class="max-w-6xl mx-auto">
      <div class="mb-12 max-w-2xl">
        <h2 id="avis-titre" class="font-display text-4xl lg:text-5xl text-foret">{SITE.totalReviews} clients satisfaits</h2>
        <p class="mt-3 text-gris">
          <span class="etoiles" aria-hidden="true">★★★★★</span>
          <span class="font-semibold text-encre ml-1">{note(SITE.globalRating)}/5</span>.
          Extraits mot pour mot d'avis vérifiés publiés sur nos fiches produit.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-10 md:gap-8">
        {testimonials.map(({ name, pack, texte }) => (
          <figure class="border-t-2 border-anis pt-6">
            <blockquote class="font-display text-[1.35rem] leading-snug text-encre">« {texte} »</blockquote>
            <figcaption class="mt-5 text-sm text-gris">
              <span class="font-semibold text-encre">{name}</span>, {pack}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       PREUVE SOCIALE AMAZON
       Avis Amazon, distincts des avis du site : la mention « sur Amazon »
       est portée par le composant, jamais mélangée à la note du site.
  ══════════════════════════════════ -->
  <AmazonProof />

  <!-- ══════════════════════════════════
       GUIDES — blog / ressources
  ══════════════════════════════════ -->
  <section class="py-20 lg:py-28 px-4 sm:px-6" aria-labelledby="guides-titre">
    <div class="max-w-6xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
        <h2 id="guides-titre" class="font-display text-4xl lg:text-5xl text-foret max-w-2xl">Tout savoir sur les perles de céramique</h2>
        <a href="/blog/" class="lien-souligne">Tous les guides</a>
      </div>
      <div class="grid md:grid-cols-2 gap-x-10">
        {guides.filter((g) => g.category !== 'Achat').map((guide) => (
          <article class="border-t border-pierre py-7">
            <p class="text-sm text-olive mb-2">{guide.category}</p>
            <h3 class="font-display text-2xl text-encre mb-2 leading-tight">
              <a href={guide.href} class="hover:text-foret transition-colors">{guide.title}</a>
            </h3>
            <p class="text-gris text-sm leading-relaxed max-w-[60ch]">{guide.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════
       REVENDEURS — magasins bio et vendeurs professionnels
       (conditions lues dans src/data/revendeur.ts, jamais recopiées)
  ══════════════════════════════════ -->
  <section class="py-20 lg:py-28 px-4 sm:px-6 bg-nuit text-anis-pale" aria-labelledby="revendeurs-titre">
    <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_1.1fr] gap-12 lg:gap-16 items-start">
      <div>
        <p class="text-sm text-anis mb-4">Magasins bio et vendeurs professionnels</p>
        <h2 id="revendeurs-titre" class="font-display text-4xl lg:text-5xl leading-[1.08] text-anis-pale mb-6 text-balance">
          Devenez revendeur de notre marque
        </h2>
        <p class="text-brume text-lg leading-relaxed max-w-[52ch] mb-8">
          Boutiques bio, épiceries vrac, praticiens, revendeurs en ligne : remplissez le formulaire
          de candidature. Une fois votre activité vérifiée, vous recevez votre accès et commandez
          au tarif professionnel.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/revendeurs/#demande-titre" class="bouton bouton-anis">Remplir le formulaire de candidature</a>
          <a href="/pro/connexion/" class="bouton bouton-contour-clair">Déjà validé : mon espace</a>
        </div>
      </div>
      <ul class="list-none m-0 p-0 border-t border-anis/25">
        {conditionsPro.map((c) => (
          <li class="border-b border-anis/25 py-6">
            <p class="font-display text-2xl text-anis-pale mb-1">{c.titre}</p>
            <p class="text-brume leading-relaxed">{c.texte}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ══════════════════════════════════
       FAQ — accordéon visible + schema FAQPage (GEO / People Also Ask)
  ══════════════════════════════════ -->
  <div class="bg-anis-pale">
    <Faq
      items={homeFaqItems}
      eyebrow="Questions fréquentes"
      title="Tout savoir avant de vous lancer"
    />
  </div>

  <!-- ══════════════════════════════════
       MISSION
  ══════════════════════════════════ -->
  <section class="py-20 lg:py-28 px-4 bg-anis text-encre">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-display text-4xl lg:text-5xl mb-6 leading-tight text-foret">
        Purifiez votre eau naturellement, et jetez moins de plastique
      </h2>
      <p class="text-encre leading-relaxed mb-10 text-lg max-w-[60ch] mx-auto">
        Un foyer qui passe aux perles cesse d'acheter de l'eau en bouteille :
        moins de plastique jeté, moins de packs à porter, et une eau du robinet
        enfin agréable à boire. C'est exactement pour ça que nous existons.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/perles-ceramique-em/" class="bouton bouton-plein">
          Choisir mon pack, dès {prixDEntree()}
        </a>
        <a href="/a-propos/" class="bouton bouton-contour-encre">
          Notre histoire
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
