---
import { faqPour } from '../../data/faq';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import { products, SITE, prixDEntree } from '../../data/products';
import { buildFaqSchema, buildItemListSchema } from '../../lib/seo';
import CarteProduit from '../../components/CarteProduit.astro';
import { PERLES_PAR_LITRE } from '../../data/dosages';
import EnTetePage from '../../components/EnTetePage.astro';

const metaTitle = 'Perles de Céramique EM® : Purifier l\'Eau | Aimez la Nature';
const metaDescription =
  `Perles de céramique EM® japonaises : moins de chlore et de tartre, meilleur goût de l'eau. Dès ${prixDEntree()}, livraison offerte dès ${SITE.freeShippingThreshold} €.`;

// Questions issues des « Autres questions posées » de Google (recherche DataForSEO)
// Questions gérées dans Sanity (Studio → Questions fréquentes → page « collection »).
const faqItems = faqPour('collection');

// Best-seller affiché en premier (tri stable : le reste garde son ordre).
const displayProducts = [...products].sort((a, b) => Number(b.bestseller ?? false) - Number(a.bestseller ?? false));

const jsonLd = [buildItemListSchema(displayProducts), buildFaqSchema(faqItems)];

// Guide de choix rapide : usage → pack recommandé.
// Les packs se choisissent par cumul d'usages, pas par contenant unique :
// à 15 perles/litre, une carafe de 2 L n'en demande que 30.
const usageGuide = [
  { usage: 'Une carafe + la bouilloire ou la cafetière', pack: 'Pack 55', slug: 'pack-55-perles', perles: '55 perles' },
  { usage: 'Plusieurs usages : carafe, lave-vaisselle, machine à laver', pack: 'Pack 100', slug: 'pack-100-perles', perles: '100 perles' },
  { usage: 'Eau pure en déplacement', pack: 'Pack Gourde', slug: 'pack-gourde-ceramique-em', perles: 'Gourde + 100 perles' },
  { usage: 'Vous avez déjà des perles', pack: 'Gourde Écologique', slug: 'gourde-ecologique', perles: 'Gourde 500 ml seule' },
];
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={jsonLd}>
  <!-- HERO collection -->
  <EnTetePage surTitre="Fabriquées au Japon, procédé EM® original">
    <Fragment slot="titre">Perles de céramique EM® : purifiez l'eau du robinet naturellement</Fragment>
      <p>
        Aussi appelées billes de céramique, nos perles d'argile enrichie en Micro-organismes
        Efficaces (EM®) réduisent le chlore, adoucissent le goût et limitent le tartre —
        sans cartouche à remplacer, sans plastique, pendant des années.
      </p>
      <p class="text-sm">
        <span class="etoiles" aria-hidden="true">★</span>
        <strong class="text-encre">{SITE.globalRating.toString().replace('.', ',')}/5</strong>, {SITE.totalReviews} avis vérifiés.
        Livraison offerte dès {SITE.freeShippingThreshold} €. Garantie 30 jours.
      </p>
  </EnTetePage>

  <!-- GRILLE PRODUITS — même carte que l'accueil (CarteProduit). -->
  <section class="py-16 lg:py-20 px-4 sm:px-6" aria-labelledby="packs-titre">
    <div class="max-w-6xl mx-auto">
      <h2 id="packs-titre" class="font-display text-4xl lg:text-5xl text-foret mb-10">Nos packs de perles EM®</h2>
      <ul class="grid grid-cols-2 lg:grid-cols-4 gap-x-4 gap-y-10 lg:gap-6 list-none p-0 m-0">
        {displayProducts.map((p) => (
          <li><CarteProduit produit={p} /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- GUIDE DE CHOIX -->
  <section class="py-16 lg:py-20 px-4 sm:px-6 bg-anis-pale" aria-labelledby="choix-titre">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm text-olive mb-3">Guide de choix</p>
      <h2 id="choix-titre" class="font-display text-3xl lg:text-4xl text-foret mb-8">Quel pack pour quel usage ?</h2>
      <div class="overflow-x-auto rounded-xl border border-pierre bg-white">
        <table class="w-full text-sm text-left">
          <thead>
            <tr class="bg-nuit text-white">
              <th scope="col" class="px-5 py-3.5 font-semibold">Votre usage</th>
              <th scope="col" class="px-5 py-3.5 font-semibold">Pack recommandé</th>
              <th scope="col" class="px-5 py-3.5 font-semibold">Contenu</th>
            </tr>
          </thead>
          <tbody>
            {usageGuide.map((row, i) => (
              <tr class={i % 2 ? 'bg-coquille' : 'bg-white'}>
                <td class="px-5 py-3.5 text-gris">{row.usage}</td>
                <td class="px-5 py-3.5">
                  <a href={`/perles-ceramique-em/${row.slug}/`} class="font-semibold text-foret hover:underline">{row.pack}</a>
                </td>
                <td class="px-5 py-3.5 text-gris">{row.perles}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-sm text-gris mt-4">
        Règle simple : comptez <strong>{PERLES_PAR_LITRE} perles par litre d'eau</strong> de boisson.
        Tous les détails dans notre guide <a href="/comment-ca-marche/" class="text-foret font-semibold hover:underline">Comment ça marche ?</a>
      </p>
    </div>
  </section>

  <!-- MAILLAGE GUIDES -->
  <section class="py-16 lg:py-20 px-4 sm:px-6 bg-white" aria-labelledby="guides-titre">
    <div class="max-w-4xl mx-auto">
      <h2 id="guides-titre" class="font-display text-3xl text-foret mb-8">Avant d'acheter, informez-vous</h2>
      <div class="grid sm:grid-cols-2 gap-5">
        <a href="/blog/les-bienfaits-des-perles-de-ceramique/" class="group rounded-xl border border-ligne p-6 hover:border-pierre-fonce transition-colors">
          <p class="text-sm text-olive mb-2">Avis & science</p>
          <p class="font-display text-xl text-encre group-hover:text-foret transition-colors mb-2">Perles de céramique : dangers, avis scientifique, ce qui est prouvé</p>
          <p class="text-sm text-gris">Notre réponse honnête aux questions que tout le monde se pose. →</p>
        </a>
        <a href="/purifier-eau-robinet-comparatif/" class="group rounded-xl border border-ligne p-6 hover:border-pierre-fonce transition-colors">
          <p class="text-sm text-olive mb-2">Comparatif</p>
          <p class="font-display text-xl text-encre group-hover:text-foret transition-colors mb-2">Perles, charbon binchotan, carafe filtrante ou osmoseur ?</p>
          <p class="text-sm text-gris">Le match des solutions pour purifier l'eau du robinet. →</p>
        </a>
      </div>
    </div>
  </section>

  <Faq items={faqItems} title="Questions fréquentes sur les perles de céramique" />
</BaseLayout>
