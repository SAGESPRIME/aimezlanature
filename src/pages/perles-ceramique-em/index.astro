---
import { Image } from 'astro:assets';
import { faqPour } from '../../data/faq';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import { products, SITE, prixDEntree } from '../../data/products';
import { buildFaqSchema, buildItemListSchema } from '../../lib/seo';
import { getProductPhoto } from '../../lib/productImages';
import { PERLES_PAR_LITRE } from '../../data/dosages';

const metaTitle = 'Perles de Céramique EM® : Purifier l\'Eau | Aimez la Nature';
const metaDescription =
  `Perles de céramique EM® japonaises : moins de chlore et de tartre, meilleur goût de l'eau. Dès ${prixDEntree()}, livraison offerte dès ${SITE.freeShippingThreshold} €.`;

// Questions issues des « Autres questions posées » de Google (recherche DataForSEO)
// Questions gérées dans Sanity (Studio → Questions fréquentes → page « collection »).
const faqItems = faqPour('collection');

// Best-seller affiché en premier (tri stable : le reste garde son ordre).
const displayProducts = [...products].sort((a, b) => Number(b.bestseller ?? false) - Number(a.bestseller ?? false));

const jsonLd = [buildItemListSchema(displayProducts), buildFaqSchema(faqItems)];

// Guide de choix rapide : usage → pack recommandé.
// Les packs se choisissent par cumul d'usages, pas par contenant unique :
// à 15 perles/litre, une carafe de 2 L n'en demande que 30.
const usageGuide = [
  { usage: 'Une carafe + la bouilloire ou la cafetière', pack: 'Pack 55', slug: 'pack-55-perles', perles: '55 perles' },
  { usage: 'Plusieurs usages : carafe, lave-vaisselle, machine à laver', pack: 'Pack 100', slug: 'pack-100-perles', perles: '100 perles' },
  { usage: 'Eau pure en déplacement', pack: 'Pack Gourde', slug: 'pack-gourde-ceramique-em', perles: 'Gourde + 100 perles' },
  { usage: 'Vous avez déjà des perles', pack: 'Gourde Écologique', slug: 'gourde-ecologique', perles: 'Gourde 500 ml seule' },
];
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={jsonLd}>
  <!-- HERO collection -->
  <section class="bg-anis-pale px-4 pt-12 pb-16">
    <div class="max-w-6xl mx-auto">
      <p class="text-sm text-olive mb-4">Fabriquées au Japon · Procédé EM® original</p>
      <h1 class="font-display text-4xl lg:text-5xl xl:text-6xl text-encre leading-[1.08] max-w-3xl mb-6">
        Perles de céramique EM® : purifiez l'eau du robinet <em class="not-italic text-foret">naturellement</em>
      </h1>
      <p class="text-gris text-lg leading-relaxed max-w-2xl mb-6">
        Aussi appelées billes de céramique, nos perles d'argile enrichie en Micro-organismes
        Efficaces (EM®) réduisent le chlore, adoucissent le goût et limitent le tartre —
        sans cartouche à remplacer, sans plastique, pendant des années.
      </p>
      <div class="flex flex-wrap items-center gap-5 text-sm text-gris">
        <span><strong class="text-encre">★ {SITE.globalRating.toString().replace('.', ',')}/5</strong> · {SITE.totalReviews} avis vérifiés</span>
        <span class="w-px h-5 bg-pierre" aria-hidden="true"></span>
        <span>Livraison offerte dès {SITE.freeShippingThreshold} €</span>
        <span class="w-px h-5 bg-pierre" aria-hidden="true"></span>
        <span>Garantie 30 jours</span>
      </div>
    </div>
  </section>

  <!-- GRILLE PRODUITS -->
  <section class="py-16 px-4 bg-white" aria-labelledby="packs-titre">
    <div class="max-w-6xl mx-auto">
      <h2 id="packs-titre" class="font-display text-3xl lg:text-4xl text-foret mb-10">Nos packs de perles EM®</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {displayProducts.map((p) => (
          <article class={`relative rounded-3xl border p-7 lg:p-8 flex flex-col gap-4 transition-shadow hover:shadow-lg ${p.inStock ? 'border-ligne bg-coquille' : 'border-ligne bg-coquille opacity-70'}`}>
            {getProductPhoto(p.slug) && (
              <a href={`/perles-ceramique-em/${p.slug}/`} class="block rounded-2xl overflow-hidden bg-white -mx-1 -mt-1">
                {/* La carte fait ~510 px de large en desktop (grille 2 colonnes).
                    L'ancien `sizes` annonçait 380 px : le navigateur choisissait un
                    fichier trop petit, agrandi de 34 % dès le DPR 1 et ~2,7× en retina.
                    La variante 1120 couvre le rendu retina. Mesuré au navigateur. */}
                <Image
                  {...getProductPhoto(p.slug)!}
                  width={1120}
                  height={1120}
                  widths={[320, 560, 1120]}
                  sizes="(max-width: 768px) 100vw, 560px"
                  loading="lazy"
                  class="w-full aspect-square object-cover transition-transform duration-300 hover:scale-[1.03]"
                />
              </a>
            )}
            <div class="flex items-start justify-between gap-3">
              <div>
                {p.bestseller && (
                  <span class="inline-block bg-foret text-white text-xs font-semibold px-3 py-1 rounded-full mb-2">Bestseller</span>
                )}
                {!p.inStock && (
                  <span class="inline-block bg-gris text-white text-xs font-semibold px-3 py-1 rounded-full mb-2">En rupture de stock</span>
                )}
                <h3 class="font-display text-2xl text-encre">
                  <a href={`/perles-ceramique-em/${p.slug}/`} class="hover:text-foret transition-colors">{p.name}</a>
                </h3>
                {p.rating && p.reviewCount && (
                  <p class="text-sm text-olive mt-1" aria-label={`Note ${p.rating} sur 5, ${p.reviewCount} avis`}>
                    ★ {p.rating.toString().replace('.', ',')}/5 · {p.reviewCount} avis
                  </p>
                )}
              </div>
              <div class="text-right flex-shrink-0">
                {p.priceOriginal && <p class="text-xs text-olive line-through">{p.priceOriginal.toFixed(2).replace('.', ',')} €</p>}
                <p class="font-display text-2xl font-bold text-foret">{p.priceCurrent.toFixed(2).replace('.', ',')} €</p>
                {p.priceOriginal && <p class="text-xs text-gris">-{p.discountPercent} %</p>}
              </div>
            </div>
            <ul class="flex flex-wrap gap-2">
              {p.usages.map((u) => (
                <li class="text-xs bg-anis-pale text-gris px-3 py-1.5 rounded-full">{u}</li>
              ))}
            </ul>
            <a
              href={`/perles-ceramique-em/${p.slug}/`}
              class={`mt-auto inline-flex justify-center items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold transition-colors ${p.inStock ? 'bg-foret text-white hover:bg-foret-fonce' : 'border border-gris text-gris'}`}
            >
              {p.inStock ? 'Purifier mon eau →' : 'Voir · Être notifié'}
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- GUIDE DE CHOIX -->
  <section class="py-16 px-4 bg-anis-pale" aria-labelledby="choix-titre">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm text-olive mb-3">Guide de choix</p>
      <h2 id="choix-titre" class="font-display text-3xl lg:text-4xl text-foret mb-8">Quel pack pour quel usage ?</h2>
      <div class="overflow-x-auto rounded-2xl border border-pierre bg-white">
        <table class="w-full text-sm text-left">
          <thead>
            <tr class="bg-nuit text-white">
              <th scope="col" class="px-5 py-3.5 font-semibold">Votre usage</th>
              <th scope="col" class="px-5 py-3.5 font-semibold">Pack recommandé</th>
              <th scope="col" class="px-5 py-3.5 font-semibold">Contenu</th>
            </tr>
          </thead>
          <tbody>
            {usageGuide.map((row, i) => (
              <tr class={i % 2 ? 'bg-coquille' : 'bg-white'}>
                <td class="px-5 py-3.5 text-gris">{row.usage}</td>
                <td class="px-5 py-3.5">
                  <a href={`/perles-ceramique-em/${row.slug}/`} class="font-semibold text-foret hover:underline">{row.pack}</a>
                </td>
                <td class="px-5 py-3.5 text-gris">{row.perles}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-sm text-gris mt-4">
        Règle simple : comptez <strong>{PERLES_PAR_LITRE} perles par litre d'eau</strong> de boisson.
        Tous les détails dans notre guide <a href="/comment-ca-marche/" class="text-foret font-semibold hover:underline">Comment ça marche ?</a>
      </p>
    </div>
  </section>

  <!-- MAILLAGE GUIDES -->
  <section class="py-16 px-4 bg-white" aria-labelledby="guides-titre">
    <div class="max-w-4xl mx-auto">
      <h2 id="guides-titre" class="font-display text-3xl text-foret mb-8">Avant d'acheter, informez-vous</h2>
      <div class="grid sm:grid-cols-2 gap-5">
        <a href="/blog/les-bienfaits-des-perles-de-ceramique/" class="group rounded-2xl border border-ligne p-6 hover:border-pierre-fonce transition-colors">
          <p class="text-sm text-olive mb-2">Avis & science</p>
          <p class="font-display text-xl text-encre group-hover:text-foret transition-colors mb-2">Perles de céramique : dangers, avis scientifique, ce qui est prouvé</p>
          <p class="text-sm text-gris">Notre réponse honnête aux questions que tout le monde se pose. →</p>
        </a>
        <a href="/purifier-eau-robinet-comparatif/" class="group rounded-2xl border border-ligne p-6 hover:border-pierre-fonce transition-colors">
          <p class="text-sm text-olive mb-2">Comparatif</p>
          <p class="font-display text-xl text-encre group-hover:text-foret transition-colors mb-2">Perles, charbon binchotan, carafe filtrante ou osmoseur ?</p>
          <p class="text-sm text-gris">Le match des solutions pour purifier l'eau du robinet. →</p>
        </a>
      </div>
    </div>
  </section>

  <Faq items={faqItems} title="Questions fréquentes sur les perles de céramique" />
</BaseLayout>
