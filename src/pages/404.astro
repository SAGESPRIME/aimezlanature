---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaPacks from '../components/CtaPacks.astro';
import { guides } from '../data/guides';
import EnTetePage from '../components/EnTetePage.astro';

const metaTitle = 'Page introuvable | Aimez la Nature';
const metaDescription =
  'Cette page n\'existe pas ou plus. Retrouvez nos packs de Perles de Céramique EM® et nos guides pratiques.';
---

<BaseLayout title={metaTitle} description={metaDescription} noindex>
  <EnTetePage centre>
    <Fragment slot="titre">Cette page s'est évaporée</Fragment>
    <p class="text-gris text-lg leading-relaxed mb-8">
      L'adresse demandée n'existe pas ou plus. Pas de panique : tout ce qui compte
      est à portée de clic.
    </p>
    <a
      href="/perles-ceramique-em/"
      class="inline-flex items-center gap-2 bg-foret text-white px-7 py-3.5 rounded-full font-semibold text-sm hover:bg-foret-fonce transition-colors"
    >
      Voir nos packs de perles <span aria-hidden="true">→</span>
    </a>
  </EnTetePage>

  <section class="py-16 lg:py-20 px-4 sm:px-6 bg-white" aria-labelledby="guides-404">
    <div class="max-w-4xl mx-auto">
      <h2 id="guides-404" class="font-display text-2xl text-foret mb-6">Ou consultez un guide</h2>
      <ul class="grid sm:grid-cols-2 gap-3 text-sm">
        {guides.map((g) => (
          <li>
            <a href={g.href} class="block rounded-xl border border-ligne bg-coquille px-4 py-3 text-foret font-semibold hover:border-pierre-fonce transition-colors">
              {g.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaPacks />
</BaseLayout>
