---
/**
 * Page revendeur (B2B) — boutiques bio et vendeurs professionnels.
 *
 * Volontairement une page unique et non un cluster de contenu : la recherche
 * DataForSEO du 23/07/2026 montre zéro volume sur « grossiste perles de
 * céramique », « perles de céramique en gros » et « revendeur produits
 * écologiques ». Son trafic ne viendra pas de Google mais du lien en pied de
 * page et du démarchage direct — d'où une page conçue pour convaincre, pas
 * pour ranker.
 *
 * Absente du menu principal : elle ne doit pas polluer le parcours des clients
 * particuliers.
 *
 * Toutes les données viennent de src/data/revendeur.ts. Aucun tarif n'est
 * affiché tant que le marchand n'a pas validé sa grille (voir la règle en tête
 * de ce fichier de données).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import RevendeurForm from '../../components/RevendeurForm.astro';
import { SITE } from '../../data/products';
import { buildFaqSchema } from '../../lib/seo';
import { argumentsRevente, conditionsPro, etapes, faqPro } from '../../data/revendeur';

const metaTitle = 'Devenir revendeur — Perles de Céramique EM® | Aimez la Nature';
const metaDescription =
  'Boutiques bio, épiceries vrac, praticiens : revendez les Perles de Céramique EM® japonaises. −30 % sur les prix publics, minimum 300 €, réponse sous 24 h.';

const jsonLd = buildFaqSchema(faqPro);
// Virgule décimale française : `4.8` s'écrit « 4,8 » en toutes lettres sur la page.
const noteFr = SITE.globalRating.toString().replace('.', ',');
const noteAmazonFr = SITE.amazon.rating.toString().replace('.', ',');
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="py-16 lg:py-20 px-4 sm:px-6 bg-nuit text-anis-pale">
    <div class="mx-auto max-w-4xl">
      <p class="mb-4 text-sm text-anis">Espace professionnels</p>
      <h1 class="font-display mb-6 text-4xl leading-[1.1] text-anis-pale lg:text-5xl">
        Revendez les Perles de Céramique EM® dans votre boutique
      </h1>
      <p class="max-w-2xl text-lg leading-relaxed text-brume">
        Marque française depuis {SITE.foundingYear}, revendeur agréé EM, perles authentiques
        importées du Japon. Nous ouvrons notre catalogue aux boutiques bio, épiceries vrac,
        praticiens et commerçants qui veulent proposer une alternative crédible aux carafes
        filtrantes.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#demande-titre"
          class="inline-flex rounded-full bg-anis px-7 py-3.5 text-sm font-semibold text-nuit transition-colors hover:bg-anis-pale"
        >
          Devenir revendeur
        </a>
        <a
          href="/pro/connexion/"
          class="inline-flex rounded-full border border-anis/50 px-7 py-3.5 text-sm font-semibold text-anis-pale transition-colors hover:bg-white/10"
        >
          Espace revendeur (déjà validé)
        </a>
      </div>
    </div>
  </section>

  <!-- POURQUOI ÇA TOURNE EN RAYON -->
  <section class="py-16 lg:py-20 px-4 sm:px-6 bg-white" aria-labelledby="arguments-titre">
    <div class="mx-auto max-w-4xl">
      <p class="mb-3 text-sm text-olive">L'intérêt pour vous</p>
      <h2 id="arguments-titre" class="font-display mb-4 text-3xl text-foret lg:text-4xl">
        Un produit qui se vend sans forcer
      </h2>
      <p class="mb-10 max-w-2xl leading-relaxed text-gris">
        {`${SITE.totalReviews} avis vérifiés sur nos fiches (${noteFr}/5) et ${SITE.amazon.reviewCount} commentaires sur Amazon (${noteAmazonFr}/5) :`}
        le produit a déjà fait ses preuves auprès du grand public avant d'arriver dans votre rayon.
      </p>

      {/* Pas de [data-reveal] sur ces cartes ni sur les étapes plus bas :
          global.css avertit qu'un bloc porteur de l'argumentaire resterait à
          opacity 0 tant que site.js n'a pas tourné. Les cartes produits de
          l'accueil en ont été retirées pour la même raison — un revendeur doit
          voir ces arguments sans condition. */}
      <div class="grid gap-5 sm:grid-cols-2">
        {argumentsRevente.map((a) => (
          <div class="rounded-xl border border-ligne bg-coquille p-6">
            <h3 class="font-display mb-2 text-xl text-encre">{a.titre}</h3>
            <p class="text-sm leading-relaxed text-gris">{a.texte}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- VOS CONDITIONS (validées par le marchand, calculées par commande-pro.mjs) -->
  <section class="py-16 lg:py-20 px-4 sm:px-6 bg-anis-pale" aria-labelledby="remise-titre">
    <div class="mx-auto max-w-4xl">
      <p class="mb-3 text-sm text-olive">Vos conditions</p>
      <h2 id="remise-titre" class="font-display mb-8 text-3xl text-foret lg:text-4xl">
        Des conditions simples, les mêmes pour tous
      </h2>
      <ul class="grid gap-4 sm:grid-cols-3 list-none p-0 m-0">
        {conditionsPro.map((c) => (
          <li class="rounded-xl border border-pierre bg-white p-6">
            <p class="font-display text-2xl text-encre leading-tight">{c.titre}</p>
            <p class="mt-2 text-sm leading-relaxed text-gris">{c.texte}</p>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-gris">
        Déjà revendeur ? <a href="/pro/connexion/" class="lien-souligne">Accéder à mon espace revendeur</a>
      </p>
    </div>
  </section>

  <!-- COMMENT ÇA SE PASSE -->
  <section class="py-16 lg:py-20 px-4 sm:px-6 bg-white" aria-labelledby="etapes-titre">
    <div class="mx-auto max-w-3xl">
      <p class="mb-3 text-sm text-olive">Le déroulé</p>
      <h2 id="etapes-titre" class="font-display mb-8 text-3xl text-foret lg:text-4xl">
        Comment ça se passe
      </h2>
      <ol class="space-y-5">
        {etapes.map((e, i) => (
          <li class="flex gap-4">
            <span
              class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-foret text-sm font-bold text-white"
              aria-hidden="true"
            >
              {i + 1}
            </span>
            <div>
              <h3 class="mb-1 font-semibold text-encre">{e.titre}</h3>
              <p class="text-sm leading-relaxed text-gris">{e.texte}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Faq items={faqPro} title="Questions des professionnels" eyebrow="FAQ pro" />

  <RevendeurForm />
</BaseLayout>
