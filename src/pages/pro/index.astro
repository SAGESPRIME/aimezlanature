---
/**
 * Espace revendeurs — commande à −30 %, minimum 300 €, Colissimo au poids.
 *
 * Page À LA DEMANDE : réservée à une session revendeur valide ET à un statut
 * « validé » relu dans Sanity (src/lib/pro.ts). Sinon → /pro/connexion/.
 * Noindex, hors sitemap, jamais mise en cache (service worker compris).
 * Les montants affichés sont calculés par public/js/pro.js avec les mêmes
 * règles que /api/pro/checkout (src/data/commande-pro.mjs), qui seul fixe le
 * montant débité.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnTetePage from '../../components/EnTetePage.astro';
import { products, SITE } from '../../data/products';
import { MINIMUM_PRO, QTE_MAX_PRO, REMISE_PRO, prixPro } from '../../data/commande-pro.mjs';
import { fmtPrice } from '../../lib/pricing';
import { getProductPhoto } from '../../lib/productImages';
import { jsonPourScript } from '../../lib/json-script';
import { sessionPro } from '../../lib/pro';

export const prerender = false;

const pro = await sessionPro(Astro.cookies).catch(() => null);
if (!pro) return Astro.redirect('/pro/connexion/', 303);
Astro.response.headers.set('Cache-Control', 'private, no-store');

const catalogue = {
  remise: REMISE_PRO,
  minimum: MINIMUM_PRO,
  qteMax: QTE_MAX_PRO,
  livraison: { ...SITE.livraison, poidsMaxForfait: 0 },
  produits: products.map((p) => ({ slug: p.slug, prix: prixPro(p.priceCurrent), poids: p.poids, enStock: p.inStock })),
};
const euros = (n: number) => `${fmtPrice(n)} €`;
---

<BaseLayout title="Commande revendeur | Aimez la Nature" description="Espace de commande réservé aux revendeurs validés." noindex>
  <script type="application/json" id="catalogue-pro" set:html={jsonPourScript(catalogue)} />

  <EnTetePage surTitre={`Espace revendeur — ${pro.boutique ?? ''}`}>
    <Fragment slot="titre">Votre commande revendeur</Fragment>
    <p>
      Tarif −{Math.round(REMISE_PRO * 100)} % sur nos prix publics, minimum {MINIMUM_PRO} € de produits,
      livraison Colissimo selon le poids. Paiement sécurisé par Stripe.
    </p>
  </EnTetePage>

  <section class="px-4 sm:px-6 py-12 lg:py-16">
    <div class="max-w-6xl mx-auto grid lg:grid-cols-[1fr_340px] gap-10 items-start">
      <ul class="list-none p-0 m-0 divide-y divide-ligne border-y border-ligne">
        {products.map((p) => {
          const photo = getProductPhoto(p.slug);
          return (
            <li class="grid grid-cols-[72px_1fr] sm:grid-cols-[88px_1fr_auto] gap-4 py-5 items-center">
              <div class="aspect-square rounded-md border border-ligne bg-white overflow-hidden">
                {photo && <Image {...photo} width={176} height={176} class="w-full h-full object-contain p-1.5" />}
              </div>
              <div>
                <p class="font-semibold text-encre leading-snug">{p.name}</p>
                <p class="text-sm text-gris mt-1">
                  <strong class="text-encre tabular-nums">{euros(prixPro(p.priceCurrent))}</strong>
                  <s class="ml-2 tabular-nums">{euros(p.priceCurrent)}</s>
                  <span class="ml-2">· {p.poids} g</span>
                </p>
                {!p.inStock && <p class="text-sm text-[#9B3B3B] mt-1">Bientôt de retour</p>}
              </div>
              <label class="col-start-2 sm:col-start-auto flex items-center gap-2 text-sm text-gris">
                Quantité
                <input
                  type="number"
                  inputmode="numeric"
                  min="0"
                  max={QTE_MAX_PRO}
                  value="0"
                  data-qte-pro={p.slug}
                  disabled={!p.inStock}
                  class="w-24 rounded-lg border border-pierre bg-white px-3 py-2.5 text-base text-encre tabular-nums disabled:opacity-50"
                />
              </label>
            </li>
          );
        })}
      </ul>

      <aside class="rounded-xl border border-pierre bg-white p-6 lg:sticky lg:top-28" aria-labelledby="recap-pro">
        <h2 id="recap-pro" class="font-display text-2xl text-foret mb-4">Récapitulatif</h2>
        <dl class="space-y-2 text-sm">
          <div class="flex justify-between"><dt class="text-gris">Produits (−{Math.round(REMISE_PRO * 100)} %)</dt><dd data-pro="sous-total" class="tabular-nums">0,00 €</dd></div>
          <div class="flex justify-between"><dt class="text-gris">Poids du colis</dt><dd data-pro="poids" class="tabular-nums">0 g</dd></div>
          <div class="flex justify-between"><dt class="text-gris">Livraison Colissimo</dt><dd data-pro="livraison" class="tabular-nums">—</dd></div>
          <div class="flex justify-between border-t border-ligne pt-3 text-base font-semibold text-encre"><dt>Total TTC</dt><dd data-pro="total" class="tabular-nums">0,00 €</dd></div>
        </dl>
        <p data-pro="message" class="mt-4 text-sm text-olive" role="status">Minimum {MINIMUM_PRO} € de produits.</p>
        <button type="button" data-pro="payer" disabled class="bouton bouton-plein w-full mt-4 disabled:opacity-50 disabled:cursor-not-allowed">Payer ma commande</button>
        <p data-pro="erreur" hidden role="alert" class="mt-3 text-sm text-[#B91C1C]"></p>
        <form method="post" action="/api/pro/sortir" class="mt-6">
          <button type="submit" class="text-sm text-gris underline underline-offset-2">Se déconnecter</button>
        </form>
      </aside>
    </div>
  </section>

  <script src="/js/pro.js" defer></script>
</BaseLayout>
