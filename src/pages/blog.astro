---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/products';
import { blogPosts } from '../data/blogPosts';
import EnTetePage from '../components/EnTetePage.astro';

// Titres et description repris de la version aimezlanature.vercel.app/blog.
const metaTitle = 'Blog Perles de Céramique EM | Aimez la Nature';
const metaDescription =
  "Articles et guides sur les perles de céramique EM, la purification naturelle de l'eau et les micro-organismes efficaces. Conseils, comparatifs et astuces.";

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Blog — Aimez la Nature',
    description: metaDescription,
    inLanguage: 'fr-FR',
    url: `${SITE.url}/blog/`,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Articles du blog Aimez la Nature',
    itemListElement: blogPosts.map((post, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: post.title,
      url: `${SITE.url}${post.href}`,
    })),
  },
];

// UTC forcé : sans cela, un serveur à l'ouest de Greenwich afficherait la veille.
function formatDate(iso: string): string {
  return new Date(`${iso}T00:00:00Z`).toLocaleDateString('fr-FR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
---

<BaseLayout title={metaTitle} description={metaDescription} jsonLd={jsonLd}>
  <!-- EN-TÊTE — titre centré + sous-titre, comme la version d'origine -->
  <EnTetePage emplacement="guides">
    <Fragment slot="titre">Blog — Perles de Céramique EM et Purification de l'Eau</Fragment>
    <p>
      Guides, conseils et comparatifs sur les perles de céramique EM et la
      purification naturelle de l'eau.
    </p>
  </EnTetePage>

  <!-- GRILLE D'ARTICLES — cartes blanches 2 colonnes -->
  <section class="py-16 lg:py-20 px-4 sm:px-6 bg-coquille" aria-labelledby="articles-titre">
    <h2 id="articles-titre" class="sr-only">Tous les articles</h2>
    <div class="max-w-5xl mx-auto grid md:grid-cols-2 gap-6">
      {blogPosts.map((post) => (
        <article class="flex flex-col rounded-xl border border-ligne bg-white p-6 transition-colors hover:border-pierre-fonce">
          <div class="flex items-center gap-3 mb-4">
            <span class="inline-flex items-center rounded-full bg-anis-clair px-3 py-1 text-xs font-semibold text-foret">
              {post.category}
            </span>
            <span class="inline-flex items-center gap-1.5 text-xs text-olive">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7v5l3 2" stroke-linecap="round" />
              </svg>
              {post.readingTime} de lecture
            </span>
          </div>

          <h3 class="font-display text-2xl text-encre leading-snug mb-3">
            <a href={post.href} class="hover:text-foret transition-colors">{post.title}</a>
          </h3>

          <p class="text-gris text-sm leading-relaxed mb-6">{post.excerpt}</p>

          <div class="mt-auto flex items-center justify-between border-t border-ligne pt-4">
            <time datetime={post.date} class="text-xs text-olive">
              {formatDate(post.date)}
            </time>
            <a
              href={post.href}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-foret hover:gap-3 transition-all"
            >
              Lire <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
