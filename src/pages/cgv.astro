---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/products';
import EnTetePage from '../components/EnTetePage.astro';
import { fmtPrice } from '../lib/pricing';

const metaTitle = 'Conditions Générales de Vente | Aimez la Nature';
const metaDescription =
  "Conditions Générales de Vente d'Aimez la Nature : commande, prix, livraison, droit de rétractation et garanties applicables à vos achats.";
/** 500 → « 500 g », 2000 → « 2 kg ». */
const poidsTexte = (g: number) => (g >= 1000 && g % 1000 === 0 ? `${g / 1000} kg` : `${g} g`);
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <EnTetePage surTitre="Conditions de vente">
    <Fragment slot="titre">Conditions Générales de Vente</Fragment>
  </EnTetePage>

  <section class="py-16 lg:py-20 px-4 sm:px-6 bg-white" aria-labelledby="cgv-titre">
    <div class="max-w-3xl mx-auto space-y-10 text-gris leading-relaxed">
      <div>
        <h2 class="font-display text-2xl text-foret mb-3">1. Champ d'application</h2>
        <p>
          Les présentes CGV s'appliquent à toute commande de produits passée auprès de
          SAS Naturalis Vert (« Aimez la Nature ») par un client particulier résidant en France
          métropolitaine. Passer commande implique l'acceptation pleine et entière de ces
          conditions.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-foret mb-3">2. Produits et prix</h2>
        <p>
          Les prix affichés sur le site sont exprimés en euros, toutes taxes comprises (TTC).
          SAS Naturalis Vert se réserve le droit de modifier ses prix à tout moment, les produits
          étant facturés au tarif en vigueur au moment de la validation de la commande.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-foret mb-3">3. Commande et paiement</h2>
        <p>
          Vous ajoutez les produits à votre panier, puis réglez en ligne sur la page de paiement
          sécurisée de notre prestataire Stripe. Le montant total, frais de port compris, est
          affiché avant la validation du paiement. La commande n'est confirmée qu'après
          acceptation du paiement : vous recevez alors un email de confirmation récapitulant
          votre commande, ainsi que votre reçu. Nous n'avons jamais accès à vos coordonnées
          bancaires.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-foret mb-3">4. Livraison</h2>
        <p>
          Les commandes sont livrées en France métropolitaine sous 2 à 5 jours ouvrés à compter de
          la confirmation du paiement. Les frais de livraison dépendent du poids du colis,
          emballage compris, et sont indiqués avant validation de la commande :
        </p>
        <ul class="list-disc pl-5 mt-3 space-y-1">
          <li>
            colis jusqu'à {poidsTexte(SITE.livraison.poidsMaxForfait)} : livraison offerte si la commande
            comprend {SITE.livraisonOfferteAvec}, sinon {fmtPrice(SITE.shippingFee)} € ;
          </li>
          <li>au-delà de {poidsTexte(SITE.livraison.poidsMaxForfait)} : tarif Colissimo à domicile selon le poids total.</li>
        </ul>
        <table class="mt-4 text-sm border border-ligne">
          <caption class="sr-only">Tarif Colissimo à domicile selon le poids du colis</caption>
          <thead>
            <tr class="bg-anis-pale text-encre">
              <th scope="col" class="px-4 py-2 text-left font-semibold">Poids du colis</th>
              <th scope="col" class="px-4 py-2 text-right font-semibold">Livraison</th>
            </tr>
          </thead>
          <tbody>
            {SITE.livraison.grille
              .filter((t) => t.poidsMax > SITE.livraison.poidsMaxForfait)
              .map((t) => (
                <tr class="border-t border-ligne">
                  <td class="px-4 py-2">jusqu'à {poidsTexte(t.poidsMax)}</td>
                  <td class="px-4 py-2 text-right tabular-nums">{fmtPrice(t.prix)} €</td>
                </tr>
              ))}
          </tbody>
        </table>
      </div>

      <div>
        <h2 class="font-display text-2xl text-foret mb-3">5. Droit de rétractation</h2>
        <p>
          Conformément aux articles L221-18 et suivants du Code de la consommation, vous disposez
          d'un délai de 14 jours à compter de la réception de votre commande pour exercer votre
          droit de rétractation, sans avoir à justifier de motif ni à payer de pénalité. Les
          produits doivent être retournés dans leur état d'origine. Les frais de retour restent à
          la charge du client, sauf erreur de notre part.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-foret mb-3">6. Garantie « satisfait ou remboursé » 30 jours</h2>
        <p>
          En complément du droit de rétractation légal, SAS Naturalis Vert propose une garantie
          commerciale de 30 jours à compter de la réception : si les perles ne vous conviennent
          pas, contactez-nous à{' '}
          <a href="mailto:contact@aimezlanature.fr" class="text-foret font-semibold hover:underline">contact@aimezlanature.fr</a>
          pour un remboursement.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-foret mb-3">7. Garanties légales</h2>
        <p>
          Tous nos produits bénéficient de la garantie légale de conformité (articles L217-3 et
          suivants du Code de la consommation) et de la garantie légale contre les vices cachés
          (articles 1641 et suivants du Code civil), en plus de la garantie commerciale décrite
          ci-dessus.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-foret mb-3">8. Réclamations et contact</h2>
        <p>
          Pour toute question ou réclamation relative à une commande, contactez-nous à{' '}
          <a href="mailto:contact@aimezlanature.fr" class="text-foret font-semibold hover:underline">contact@aimezlanature.fr</a>{' '}
          ou par courrier à SAS Naturalis Vert, 145 rue de Noisy-le-Sec, CS 20008, 93260 Les Lilas cedex.
          Nous répondons sous 24 h ouvrées.
        </p>
      </div>

      <div>
        <h2 class="font-display text-2xl text-foret mb-3">9. Droit applicable et juridiction</h2>
        <p>
          Les présentes CGV sont soumises au droit français. Tout litige relatif à leur
          interprétation ou leur exécution relève, à défaut de résolution amiable, de la
          compétence des tribunaux de Versailles.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
