---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import EnTetePage from '../components/EnTetePage.astro';

const metaTitle = 'Contact | Aimez la Nature';
const metaDescription =
  'Contactez Aimez la Nature par email pour toute question sur nos Perles de Céramique EM® ou votre commande. Réponse sous 24 h ouvrées.';
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <!-- HERO -->
  <EnTetePage surTitre="Contact">
    <Fragment slot="titre">Une question ? Écrivez-nous</Fragment>
    <p>
      Notre équipe répond sous 24 h ouvrées, que ce soit pour une commande, un conseil
      d'usage ou une question sur nos produits.
    </p>
  </EnTetePage>

  <!-- MOYENS DE CONTACT -->
  <section class="py-16 lg:py-20 px-4 sm:px-6 bg-white" aria-labelledby="moyens-titre">
    <div class="max-w-3xl mx-auto grid sm:grid-cols-2 gap-5">
      <div class="rounded-xl border border-ligne p-6">
        <p class="font-semibold text-encre mb-2">Par email</p>
        <p class="text-sm text-gris mb-3">
          Pour une question générale ou un suivi de commande.
        </p>
        <a href="mailto:contact@aimezlanature.fr" class="text-foret font-semibold hover:underline">
          contact@aimezlanature.fr
        </a>
      </div>
      <div class="rounded-xl border border-ligne p-6">
        <p class="font-semibold text-encre mb-2">Par courrier</p>
        <p class="text-sm text-gris mb-3">
          Siège social de la société.
        </p>
        <address class="not-italic text-encre leading-relaxed">
          SAS Naturalis Vert — Aimez la Nature<br />
          145 rue de Noisy-le-Sec, CS 20008<br />
          93260 Les Lilas cedex, France
        </address>
      </div>
    </div>
    <div class="max-w-3xl mx-auto mt-6">
      <p class="flex items-start gap-2 text-sm text-gris bg-anis-pale rounded-xl px-5 py-4">
        <Icon name="bulb" class="w-4 h-4 mt-0.5 flex-shrink-0 text-foret" />
        <span>
          Pour commander, ajoutez vos produits au panier depuis leur fiche et réglez en ligne
          par paiement sécurisé. La plupart
          des questions courantes (livraison, paiement, garantie) sont déjà traitées dans notre{' '}
          <a href="/faq/" class="text-foret font-semibold hover:underline">FAQ</a>.
        </span>
      </p>
    </div>
  </section>
</BaseLayout>
