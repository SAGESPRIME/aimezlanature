---
/**
 * Page de retour après un paiement Stripe réussi.
 *
 * `noindex` : page de tunnel, sans intérêt pour la recherche et susceptible
 * de contenir un identifiant de session dans l'URL.
 *
 * Le panier est vidé par public/js/commande.js (la CSP interdit le script
 * en ligne). La confirmation qui fait foi reste l'email envoyé par Stripe :
 * cette page ne prétend pas valider le paiement côté serveur.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { suiviAchatActif, cibleConversion } from '../data/tracking';

const metaTitle = 'Merci pour votre commande | Aimez la Nature';
const metaDescription = 'Votre commande de Perles de Céramique EM® est confirmée.';

// Cible de la conversion Google Ads, ou chaîne vide tant que l'étiquette n'est
// pas renseignée dans src/data/tracking.ts. Passée par un attribut de données
// plutôt qu'écrite dans le JS : la valeur n'existe qu'à un seul endroit.
const cibleAchat = suiviAchatActif() ? cibleConversion() : '';
---

<BaseLayout title={metaTitle} description={metaDescription} noindex>
  <div data-suivi-achat data-cible={cibleAchat} hidden></div>
  <section class="bg-anis-pale px-4 py-20">
    <div class="max-w-2xl mx-auto text-center">
      <p class="text-5xl mb-6" aria-hidden="true">🌿</p>
      <h1 class="font-display text-4xl lg:text-5xl text-encre mb-5">
        Merci pour votre commande
      </h1>
      <p class="text-gris text-lg leading-relaxed mb-8">
        Votre paiement a bien été enregistré. Vous recevez d'ici quelques minutes un email
        de confirmation avec le détail de votre commande et votre reçu.
      </p>

      <div class="rounded-2xl border border-pierre bg-white p-6 text-left mb-8">
        <h2 class="font-display text-xl text-foret mb-4">Et maintenant ?</h2>
        <ol class="space-y-3 text-sm text-gris list-decimal pl-5">
          <li>Votre colis est préparé sous 24 à 48 h ouvrées.</li>
          <li>Vous recevez un email dès son expédition.</li>
          <li>Livraison sous 2 à 5 jours ouvrés.</li>
        </ol>
      </div>

      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/comment-ca-marche/" class="inline-flex bg-foret text-white px-7 py-3.5 rounded-full font-semibold text-sm hover:bg-foret-fonce transition-colors">
          Comment utiliser vos perles →
        </a>
        <a href="/" class="inline-flex border border-olive text-olive px-7 py-3.5 rounded-full font-semibold text-sm hover:bg-olive hover:text-white transition-colors">
          Retour à l'accueil
        </a>
      </div>

      <p class="mt-8 text-sm text-gris">
        Une question ? Écrivez-nous à{' '}
        <a href="mailto:contact@aimezlanature.fr" class="font-semibold text-foret underline">contact@aimezlanature.fr</a>
      </p>
    </div>
  </section>

  <script src="/js/commande.js" defer></script>
</BaseLayout>
